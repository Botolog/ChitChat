{
  "name": "chitchat",
  "version": "0.1.0",
  "description": "Universal terminal messaging client (WhatsApp, Slack) built with OpenTUI",
  "type": "module",
  "main": "src/index.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Botolog/ChitChat.git"
  },
  "bugs": {
    "url": "https://github.com/Botolog/ChitChat/issues"
  },
  "homepage": "https://github.com/Botolog/ChitChat#readme",
  "keywords": [
    "tui",
    "terminal",
    "whatsapp",
    "slack",
    "chat",
    "opentui"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "demo": "bun run src/index.ts --demo",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:whatsapp": "bun run src/test-whatsapp.ts",
    "build": "bun build src/index.ts --compile --minify --target=bun --external @aws-sdk/client-s3 --outfile build/chitchat",
    "build:snap": "snapcraft --use-lxd",
    "build:snap-clean": "snapcraft clean && snapcraft --use-lxd"
  },
  "dependencies": {
    "@opentui/core": "^0.6.6",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/yargs": "^17.0.35",
    "typescript": "^7.0.2"
  }
}
